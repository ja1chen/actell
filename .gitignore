.env
.DS_Store


# Local diagnostics can include device identifiers, network details and host paths.
# Keep reviewed conclusions in Markdown; retain raw output locally, outside Git.
*.log
*.log.*
*.xcactivitylog
*.xcresult/
*.trace/
*.pcap
*.pcapng
/attachments/
/logs/
/diagnostics/

# Generated validation output and machine-specific session inventories.
/docs/**/evidence/
/docs/local-validation/*
!/docs/local-validation/*.md
/docs/integration/*.json
/ios-app/docs/xcode-validation/
/ios-app/docs/background-runs/validation.txt
/ios-app/docs/siri-validation/*.json

# CoreDevice diagnostics, identities and build outputs stay local.
/coredevice/swift/.build/
/coredevice/swift/.swiftpm/
/coredevice/**/pairing*.plist
/coredevice/**/identity*.plist
/coredevice/**/screen*.png
/coredevice/**/screen*.hevc
/coredevice/rust/target/

# Keep captured screens and their manifests local; retain app assets and test fixtures.
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/ios-app/docs/**/*.png
/ios-app/docs/**/*.jpg

# Local handoff snapshots.
**/handoffs/

# Device build configuration and downloaded SDK components.
/devices/esp32/firmware/managed_components/
/devices/esp32/firmware/sdkconfig*
/devices/esp32/firmware/build/
