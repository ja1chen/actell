    "0–1; usually set this or temperature, not both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0–1; usually set this or temperature, not both"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0–1；通常与 temperature 二选一"
          }
        }
      }
    },
    "0–2; the model may have additional limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0–2; the model may have additional limits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0–2；模型可能有额外约束"
          }
        }
      }
