{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "Already-localized activity status; preserve the interpolation in every language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@\nDrag from pixel (%lld, %lld) to (%lld, %lld) over %lld ms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDrag from pixel (%lld, %lld) to (%lld, %lld) over %lld ms"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n从像素 (%lld, %lld) 拖动至 (%lld, %lld)，%lld ms"
          }
        }
      }
    },
    "%@\nTap pixel (%lld, %lld)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nTap pixel (%lld, %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n点击像素 (%lld, %lld)"
          }
        }
      }
    },
    "%@\nThe action outcome is unknown. It was not resent automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nThe action outcome is unknown. It was not resent automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n本次动作结果未知；未自动重发。"
          }
        }
      }
    },
    "%@ · Offline demo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Offline demo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 离线演示"
          }
        }
      }
    },
    "%@ (%@); no automatic retry or billing change was made": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@); no automatic retry or billing change was made"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）；未自动重试或更改计费"
          }
        }
      }
    },
    "%@ authentication, tunnel, and service checks succeeded. You can test screenshots and input.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ authentication, tunnel, and service checks succeeded. You can test screenshots and input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 认证、开发者隧道和服务检查成功，可测试截图与输入"
          }
        }
      }
    },
    "%@ Before tapping or dragging, reconnect USB NCM in the control settings, confirm that NCM + HID is connected, then start a new task.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Before tapping or dragging, reconnect USB NCM in the control settings, confirm that NCM + HID is connected, then start a new task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@点击或拖动前，请在设置 → 控制调试中重新连接 USB NCM，确认显示 NCM + HID 已连接，再开始新任务。"
          }
        }
      }
    },
    "%@ connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connection"
