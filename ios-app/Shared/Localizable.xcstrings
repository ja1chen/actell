        }
      }
    },
    "A previous action has an unknown result. Check your device first. The action will not be repeated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous action has an unknown result. Check your device first. The action will not be repeated."
