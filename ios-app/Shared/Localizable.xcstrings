          }
        }
      }
    },
    "A previous background option is no longer recognized. Select your options again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous background option is no longer recognized. Select your options again."
