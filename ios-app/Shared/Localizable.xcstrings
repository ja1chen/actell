        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images and text will be sent to the current model after you send the message. Supports single-frame images up to 20 MiB and UTF-8 TXT/MD/JSON/CSV up to 256 KiB; PDF and Office files are not supported. Images are sent at a maximum dimension of 2,048 pixels. Originals stay on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送后将图片及文本内容交给当前模型。支持单帧图片 ≤20 MiB、UTF-8 TXT/MD/JSON/CSV ≤256 KiB；暂不支持 PDF/Office。图片按最长边 2048 像素发送，原图保留本机。"
          }
        }
