    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow paired phone-control devices and Muse Gadget to connect with Actell on the local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许已配对的手机操控设备和 Muse Gadget 通过本地网络连接执言。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you enable location for background execution, the app uses location services to help your task continue when you switch apps. Your location is never saved or uploaded. This uses more battery and shows the location indicator. You can decline or turn it off at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启定位后台执行时，App 会使用系统定位服务，尝试让任务在切换 App 后继续。位置不会保存或上传。定位会增加耗电并显示系统指示；你可以拒绝或随时关闭。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the images you choose to your photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你选择的图片保存到相册。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
