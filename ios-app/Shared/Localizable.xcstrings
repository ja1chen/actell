    "401: The API key is missing or invalid. Check this provider's key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "401: The API key is missing or invalid. Check this provider's key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "401：密钥无效或未提供；请检查此供应商的密钥"
          }
        }
      }
    },
    "403: This key cannot list models. You can enter an authorized model ID manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "403: This key cannot list models. You can enter an authorized model ID manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "403：此密钥无权查看模型；可手动填写已授权的模型 ID"
          }
        }
      }
    },
    "404: The model endpoint was not found. Check the protocol and base URL, or enter a model ID manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "404: The model endpoint was not found. Check the protocol and base URL, or enter a model ID manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "404：模型接口不存在；请核对协议与基础地址，或手动填写模型 ID"
          }
        }
      }
    },
    "429: The provider limited requests. Refresh later. No automatic retry was made.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "429: The provider limited requests. Refresh later. No automatic retry was made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "429：供应商限流；请稍后刷新，未自动重试"
          }
        }
      }
    },
    "A bridge connection is already being set up. Try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bridge connection is already being set up. Try again shortly."
