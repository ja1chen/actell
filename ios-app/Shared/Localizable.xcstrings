      }
    },
    "A new conversation turn has started. Previous tools will not be replayed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new conversation turn has started. Previous tools will not be replayed."
