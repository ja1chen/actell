    "%@. %@ Check USB Ethernet, the static IP, and local network permissions, then connect manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. %@ Check USB Ethernet, the static IP, and local network permissions, then connect manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。%@ 请检查 USB 以太网、固定 IP 和本地网络权限，再手动连接。"
          }
        }
      }
    },
